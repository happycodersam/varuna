  <property name="windowTitle"><string>MarineVision</string></property>
  <property name="styleSheet"><string notr="true">
* { font-family: Barlow, Segoe UI, Arial, sans-serif; font-size: 13px; }
QMainWindow, QWidget#centralwidget { background: #f4f6fb; }
QWidget#navbar { background: #fff; border-bottom: 1px solid #d0d8ee; min-height: 62px; max-height: 62px; }
QPushButton#logoBtn { background: transparent; border: none; font-size: 15px; font-weight: 700; color: #0c0d11; }
QPushButton#navBtn { background: transparent; border: none; font-size: 14px; color: #6070a0; padding: 6px 14px; border-radius: 6px; }
QPushButton#navBtn:hover { color: #0c0d11; }
QPushButton#ctaBtn { background: #3d5cd8; color: #fff; border: none; border-radius: 100px; padding: 8px 20px; font-weight: 600; }
QPushButton#ctaBtn:hover { background: #2e48b8; }
QWidget#heroSection { background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #0c0d11,stop:0.6 #1a2340,stop:1 #263668); min-height: 480px; }
QLabel#heroTitle { color: #fff; font-size: 42px; font-weight: 800; background: transparent; }
QLabel#heroSub { color: rgba(255,255,255,0.6); font-size: 15px; background: transparent; }
QLabel#heroEyebrow { color: rgba(255,255,255,0.5); font-size: 12px; background: transparent; }
QLabel#statVal { color: #fff; font-size: 28px; font-weight: 800; background: transparent; }
QLabel#statLabel { color: rgba(255,255,255,0.5); font-size: 12px; background: transparent; }
QPushButton#heroPrimary { background: #3d5cd8; color: #fff; border: none; border-radius: 100px; padding: 12px 26px; font-size: 14px; font-weight: 600; }
QPushButton#heroPrimary:hover { background: #2e48b8; }
QPushButton#heroGhost { background: transparent; color: rgba(255,255,255,0.85); border: 1px solid rgba(255,255,255,0.25); border-radius: 100px; padding: 12px 24px; font-size: 14px; }
QLabel#sectionTitle { color: #0c0d11; font-size: 24px; font-weight: 700; background: transparent; }
QLabel#sectionEyebrow { color: #6070a0; font-size: 12px; font-weight: 500; background: transparent; }
QLabel#capTitle { color: #0c0d11; font-size: 14px; font-weight: 700; background: transparent; }
QLabel#capDesc { color: #6070a0; font-size: 12px; background: transparent; }
QFrame#capCard { background: #fff; border: 1px solid #d0d8ee; border-radius: 10px; }
QWidget#pageHeader { background: #fff; border-bottom: 1px solid #d0d8ee; }
QLabel#pageTitle { color: #0c0d11; font-size: 24px; font-weight: 700; background: transparent; }
QLabel#pageSub { color: #6070a0; font-size: 13px; background: transparent; }
QLabel#pageEyebrow { color: #6070a0; font-size: 12px; background: transparent; }
QPushButton#btnPrimary { background: #3d5cd8; color: #fff; border: none; border-radius: 100px; padding: 10px 22px; font-weight: 600; }
QPushButton#btnPrimary:hover { background: #2e48b8; }
QTableWidget { background: #fff; border: 1px solid #d0d8ee; border-radius: 10px; gridline-color: #d0d8ee; }
QTableWidget::item { padding: 10px 14px; }
QTableWidget::item:selected { background: #e8edf8; color: #0c0d11; }
QHeaderView::section { background: #f4f6fb; color: #6070a0; font-size: 10px; font-weight: 700; padding: 8px 14px; border: none; border-bottom: 1px solid #d0d8ee; }
QLineEdit, QComboBox { background: #fff; border: 1px solid #d0d8ee; border-radius: 8px; padding: 8px 12px; color: #0c0d11; }
QLineEdit:focus, QComboBox:focus { border-color: #3d5cd8; }
QCheckBox { spacing: 8px; color: #0c0d11; }
QCheckBox::indicator { width: 16px; height: 16px; border-radius: 4px; border: 1.5px solid #d0d8ee; background: #fff; }
QCheckBox::indicator:checked { background: #3d5cd8; border-color: #3d5cd8; }
QSlider::groove:horizontal { height: 4px; background: #d0d8ee; border-radius: 2px; }
QSlider::handle:horizontal { background: #3d5cd8; width: 14px; height: 14px; margin: -5px 0; border-radius: 7px; }
QSlider::sub-page:horizontal { background: #3d5cd8; border-radius: 2px; }
QScrollBar:vertical { width: 4px; background: transparent; }
QScrollBar::handle:vertical { background: #8090c8; border-radius: 2px; min-height: 24px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
